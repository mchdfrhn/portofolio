---
import { ContactForm } from "./ContactForm";
---

<section id="contact" class="py-16 md:py-24 text-foreground">
    <div class="max-w-4xl mx-auto text-center px-4">
        <h2 class="text-4xl md:text-6xl font-extrabold mb-6 tracking-tight text-foreground" data-i18n-key="contact.title" data-reveal>Let's Work Together</h2>
        <div class="h-1 w-20 bg-primary rounded-full mx-auto mb-8" data-reveal data-reveal-delay="0.08"></div>
        <p class="text-xl text-muted-foreground mb-12 max-w-3xl mx-auto font-light leading-relaxed" data-i18n-key="contact.description" data-reveal data-reveal-delay="0.15">
            Currently interested in freelance opportunities or full-time positions.
            Have a project in mind or just want to say hi? Hit me up.
        </p>

        <div data-reveal data-reveal-delay="0.2">
            <ContactForm client:visible />
        </div>
    </div>
</section>
