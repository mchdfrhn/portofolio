---
import { ArrowRight, Building2, Mail } from "lucide-react";
import { reader } from "@/lib/reader";

const hero = await reader.singletons.hero.read();
const profile = await reader.singletons.profile.read();
const stats = hero?.stats ?? [
  { emoji: "🚀", label: "3+ Production Projects" },
  { emoji: "⚙️", label: "REST API" },
  { emoji: "🐘", label: "PostgreSQL" },
  { emoji: "🐳", label: "Docker" },
];

const en = hero?.en;
const id = hero?.id;
const softwareHouseName = profile?.softwareHouseName ?? "Surupan Software House";
const softwareHouseShortName = profile?.softwareHouseShortName ?? "SSH";
const softwareHouseUrl = profile?.softwareHouseUrl ?? "#";
---

<section id="hero" class="min-h-[100svh] flex flex-col justify-center relative overflow-hidden pt-28 pb-16 md:pt-24 md:pb-20">
    <!-- Aurora Background -->
    <div class="aurora-container absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="aurora-orb aurora-orb--1"></div>
        <div class="aurora-orb aurora-orb--2"></div>
        <div class="aurora-orb aurora-orb--3"></div>
        <div class="aurora-orb aurora-orb--4"></div>
        <div class="aurora-orb aurora-orb--5"></div>
    </div>

    <div class="w-full max-w-none md:max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16 flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-8">
        <div class="flex-1 space-y-8 md:space-y-10 relative z-10 w-full pl-0">
            <!-- Role / Tagline Badges -->
            <div class="hero-badges flex flex-wrap items-center gap-2.5 md:gap-3">
                <div class="hero-badge inline-flex max-w-full items-center gap-2 px-3 py-2 sm:px-4 rounded-full bg-primary-neon/10 border border-primary-neon/30 hover:bg-primary-neon/25 hover:border-primary-neon/70 hover:shadow-[0_0_20px_rgba(56,189,248,0.35)] transition-all duration-300 cursor-default">
                    <span class="w-2 h-2 rounded-full bg-primary-neon animate-pulse shadow-[0_0_8px_rgba(56,189,248,0.6)]"></span>
                    <span class="text-[11px] sm:text-sm font-bold tracking-widest text-primary-neon uppercase drop-shadow-[0_0_6px_rgba(56,189,248,0.5)]">
                        <span data-lang="en">{en?.badge ?? "Available for new opportunities"}</span>
                        <span data-lang="id" hidden>{id?.badge ?? "Terbuka untuk kolaborasi"}</span>
                    </span>
                </div>
                <a href={softwareHouseUrl} target={softwareHouseUrl === "#" ? undefined : "_blank"} rel={softwareHouseUrl === "#" ? undefined : "noopener noreferrer"} class="hero-badge inline-flex max-w-full items-center gap-2 rounded-full border border-border bg-card/80 px-3 py-2 sm:px-3.5 text-xs sm:text-sm font-semibold text-foreground/80 shadow-sm backdrop-blur-xl hover:border-secondary-neon/40 hover:text-foreground hover:shadow-[0_10px_30px_-18px_rgba(167,139,250,0.55)] transition-all duration-300">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-secondary-neon/10 text-secondary-neon">
                        <Building2 className="h-3.5 w-3.5" />
                    </span>
                    <span class="font-extrabold text-secondary-neon">{softwareHouseShortName}</span>
                    <span class="hidden h-1 w-1 rounded-full bg-muted-foreground/40 sm:block"></span>
                    <span class="truncate" data-lang="en">Founder, {softwareHouseName}</span>
                    <span class="truncate" data-lang="id" hidden>Founder, {softwareHouseName}</span>
                </a>
            </div>

            <!-- Main Headline (Hierarchy) -->
            <div class="space-y-6">
                <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight text-foreground leading-[1.1] text-glow-primary">
                    <span class="block">
                        <span data-lang="en">{en?.title1 ?? "Fullstack Developer"}</span>
                        <span data-lang="id" hidden>{id?.title1 ?? "Fullstack Developer"}</span>
                    </span>
                    <span class="block text-primary-neon mt-2 text-3xl sm:text-4xl md:text-5xl">
                        <span data-lang="en">{en?.title2 ?? "(Next.js + Laravel + Go)"}</span>
                        <span data-lang="id" hidden>{id?.title2 ?? "(Next.js + Laravel + Go)"}</span>
                    </span>
                </h1>

                <p class="text-lg md:text-2xl text-muted-foreground max-w-2xl leading-relaxed font-light">
                    <span data-lang="en">{en?.subtitle ?? "I Build Scalable Backend Systems That Handle Real-World Traffic."}</span>
                    <span data-lang="id" hidden>{id?.subtitle ?? "Saya Membangun Sistem Backend Skalabel yang Tahan Beban Produksi."}</span>
                </p>

                <!-- Quick Impact / Stats (from CMS) -->
                <div class="hero-stats flex flex-wrap gap-2.5 sm:gap-4 pt-1 pb-2 md:pt-2 md:pb-4">
                    {stats.map((stat) => (
                        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-card border border-border backdrop-blur-sm">
                            <span class="text-sm">{stat.emoji}</span>
                            <span class="text-xs font-medium text-foreground/70">{stat.label}</span>
                        </div>
                    ))}
                </div>
            </div>

            <!-- CTA Section -->
            <div class="hero-ctas flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mt-4">
                <a href="#contact" onclick="event.preventDefault(); window.lenis && window.lenis.scrollTo('#contact', {offset: -80});" class="inline-flex items-center justify-center whitespace-nowrap rounded-md ring-offset-background disabled:pointer-events-none disabled:opacity-50 h-[52px] w-full sm:w-auto px-8 text-[15px] btn-gradient-glow text-white font-extrabold border-none tracking-wide magnetic">
                    <span data-lang="en">{en?.ctaContact ?? "Hire Me"}</span>
                    <span data-lang="id" hidden>{id?.ctaContact ?? "Mari Bekerja Bersama"}</span>
                    <Mail className="ml-2 w-[18px] h-[18px]" />
                </a>
                <a href="#projects" onclick="event.preventDefault(); window.lenis && window.lenis.scrollTo('#projects', {offset: -80});" class="inline-flex items-center justify-center whitespace-nowrap rounded-md ring-offset-background disabled:pointer-events-none disabled:opacity-50 h-[52px] w-full sm:w-auto px-8 text-[15px] border border-border text-foreground hover:bg-secondary hover:border-primary-neon/50 hover:-translate-y-1 transition-all duration-300 shadow-sm font-medium bg-card/50 backdrop-blur-sm magnetic">
                    <span data-lang="en">{en?.ctaProjects ?? "Projects"}</span>
                    <span data-lang="id" hidden>{id?.ctaProjects ?? "Proyek"}</span>
                    <ArrowRight className="ml-2 w-[18px] h-[18px]" />
                </a>
            </div>
        </div>

        <!-- Right Side Visual / Hero Card -->
        <div class="hidden lg:block flex-1 w-full max-w-xl relative hero-visual opacity-90 overflow-hidden">
            <div class="bg-card/70 backdrop-blur-3xl border border-border rounded-2xl p-8 shadow-2xl rotate-2 hover:rotate-0 hover:scale-[1.02] transition-all duration-500 group hover:border-primary-neon/30">
                <div class="flex items-center justify-between mb-8 border-b border-border pb-4">
                    <div class="flex gap-2">
                        <div class="w-3.5 h-3.5 rounded-full bg-red-500/80"></div>
                        <div class="w-3.5 h-3.5 rounded-full bg-yellow-500/80"></div>
                        <div class="w-3.5 h-3.5 rounded-full bg-green-500/80"></div>
                    </div>
                    <div class="text-xs text-muted-foreground font-mono tracking-widest uppercase">focus.ts</div>
                </div>

                <div class="space-y-4 font-mono text-sm sm:text-base leading-relaxed text-foreground/70">
                    <div class="flex">
                        <span class="text-secondary-neon mr-2">const</span>
                        <span class="text-primary-neon">fokusUtama</span>
                        <span class="mx-2 text-muted-foreground/30">=</span>
                        <span class="text-foreground/60">{`{`}</span>
                    </div>
                    <div class="pl-6 flex flex-col gap-2">
                        <div>
                            <span class="text-muted-foreground mr-2">role:</span>
                            <span class="text-green-600/80 dark:text-green-400/80">
                                <span data-lang="en">{en?.codeRole ?? '"Solving architecture bottlenecks"'}</span>
                                <span data-lang="id" hidden>{id?.codeRole ?? '"Menyelesaikan bottleneck arsitektur"'}</span>
                            </span><span class="text-muted-foreground/30">,</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground mr-2">skillUtama:</span>
                            <span class="text-foreground/60">[</span><span class="text-orange-600/80 dark:text-orange-400/80">
                                <span data-lang="en">{en?.codeSkill1 ?? '"Backend"'}</span>
                                <span data-lang="id" hidden>{id?.codeSkill1 ?? '"Backend API"'}</span>
                            </span><span class="text-muted-foreground/30">, </span><span class="text-orange-600/80 dark:text-orange-400/80">
                                <span data-lang="en">{en?.codeSkill2 ?? '"Cloud Deployments"'}</span>
                                <span data-lang="id" hidden>{id?.codeSkill2 ?? '"Cloud Deployments"'}</span>
                            </span><span class="text-foreground/60">]</span><span class="text-muted-foreground/30">,</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground mr-2">impact:</span>
                            <span class="text-green-600/80 dark:text-green-400/80">
                                <span data-lang="en">{en?.codeImpact ?? '"Faster business operations"'}</span>
                                <span data-lang="id" hidden>{id?.codeImpact ?? '"Proses bisnis lebih cepat"'}</span>
                            </span><span class="text-muted-foreground/30">,</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground mr-2">delivery:</span>
                            <span class="text-secondary-neon/80">
                                <span data-lang="en">{en?.codeDelivery ?? '"On Time & Robust"'}</span>
                                <span data-lang="id" hidden>{id?.codeDelivery ?? '"Tepat Waktu & Tangguh"'}</span>
                            </span>
                        </div>
                    </div>
                    <div class="flex mt-2">
                        <span class="text-foreground/60">{`}`}</span><span class="text-muted-foreground/30">;</span>
                    </div>

                    <div class="flex mt-6 items-center gap-3 pt-6 border-t border-border opacity-50 group-hover:opacity-100 transition-opacity">
                        <span class="w-2 h-2 rounded-full bg-primary-neon animate-ping"></span>
                        <span class="text-xs text-primary-neon uppercase tracking-widest font-semibold flex-1">System is running securely</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import gsap from 'gsap';

    const initHeroAnim = () => {
        const heroEl = document.querySelector("#hero");
        if (!heroEl) return;

        const targets = heroEl.querySelectorAll(
            ".hero-badge, h1 > span, h1 + p, .hero-stats > div, .hero-ctas > a, .hero-visual"
        );

        gsap.killTweensOf(targets);
        gsap.set(targets, { clearProps: "opacity,transform" });

        const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

        tl.from(heroEl.querySelector(".hero-badge"), {
            y: 16,
            opacity: 0,
            duration: 0.6,
            delay: 0.1
        })
        .from(heroEl.querySelectorAll("h1 > span"), {
            y: 40,
            opacity: 0,
            duration: 1,
            stagger: 0.2
        }, "-=0.2")
        .from(heroEl.querySelector("h1 + p"), {
            y: 20,
            opacity: 0,
            duration: 0.8
        }, "-=0.6")
        .from(heroEl.querySelectorAll(".hero-stats > div"), {
            opacity: 0,
            scale: 0.5,
            y: 10,
            duration: 0.25,
            stagger: 0.12,
            ease: "back.out(2.5)"
        }, "-=0.3")
        .from(heroEl.querySelector(".hero-visual"), {
            opacity: 0,
            x: 20,
            scale: 0.95,
            duration: 1.2,
            ease: "back.out(1.4)"
        }, "-=0.8");
    };

    // Run on mount
    document.addEventListener('DOMContentLoaded', initHeroAnim);
    document.addEventListener('astro:after-swap', initHeroAnim);
</script>

<style>
    /* Aurora orb base */
    .aurora-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        will-change: transform, opacity;
        pointer-events: none;
    }

    /* Orb 1 — large blue, top-right */
    .aurora-orb--1 {
        width: 700px;
        height: 700px;
        top: -20%;
        right: -5%;
        background: radial-gradient(ellipse, rgba(56, 189, 248, 0.15) 0%, transparent 70%);
        animation: aurora-float-1 18s ease-in-out infinite alternate;
    }

    /* Orb 2 — purple, bottom-left */
    .aurora-orb--2 {
        width: 600px;
        height: 600px;
        bottom: -15%;
        left: -10%;
        background: radial-gradient(ellipse, rgba(167, 139, 250, 0.12) 0%, transparent 70%);
        animation: aurora-float-2 22s ease-in-out infinite alternate;
    }

    /* Orb 3 — cyan small, center-right */
    .aurora-orb--3 {
        width: 350px;
        height: 350px;
        top: 30%;
        right: 15%;
        background: radial-gradient(ellipse, rgba(34, 211, 238, 0.1) 0%, transparent 70%);
        animation: aurora-float-3 14s ease-in-out infinite alternate;
    }

    /* Orb 4 — blue-purple blend, top-left */
    .aurora-orb--4 {
        width: 450px;
        height: 450px;
        top: 5%;
        left: 5%;
        background: radial-gradient(ellipse, rgba(99, 102, 241, 0.08) 0%, transparent 70%);
        animation: aurora-float-4 25s ease-in-out infinite alternate;
    }

    /* Orb 5 — deep cyan, bottom-right */
    .aurora-orb--5 {
        width: 300px;
        height: 300px;
        bottom: 10%;
        right: 25%;
        background: radial-gradient(ellipse, rgba(56, 189, 248, 0.08) 0%, transparent 70%);
        animation: aurora-float-5 16s ease-in-out infinite alternate;
    }

    @keyframes aurora-float-1 {
        0%   { transform: translate(0, 0) scale(1); }
        33%  { transform: translate(-40px, 30px) scale(1.1); }
        66%  { transform: translate(20px, -20px) scale(0.95); }
        100% { transform: translate(-20px, 40px) scale(1.05); }
    }

    @keyframes aurora-float-2 {
        0%   { transform: translate(0, 0) scale(1); }
        40%  { transform: translate(50px, -30px) scale(1.08); }
        70%  { transform: translate(-20px, 20px) scale(0.97); }
        100% { transform: translate(30px, -40px) scale(1.04); }
    }

    @keyframes aurora-float-3 {
        0%   { transform: translate(0, 0) scale(1) rotate(0deg); }
        50%  { transform: translate(-30px, -40px) scale(1.15) rotate(10deg); }
        100% { transform: translate(20px, 30px) scale(0.9) rotate(-5deg); }
    }

    @keyframes aurora-float-4 {
        0%   { transform: translate(0, 0) scale(1); opacity: 0.8; }
        50%  { transform: translate(40px, 20px) scale(1.2); opacity: 1; }
        100% { transform: translate(-10px, 40px) scale(0.85); opacity: 0.6; }
    }

    @keyframes aurora-float-5 {
        0%   { transform: translate(0, 0) scale(1); }
        60%  { transform: translate(-25px, -35px) scale(1.1); }
        100% { transform: translate(15px, 20px) scale(0.92); }
    }

    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .aurora-orb { animation: none; }
    }
</style>
