---
import { ArrowRight, Building2, Mail } from "lucide-react";
import { reader } from "@/lib/reader";

const hero = await reader.singletons.hero.read();
const profile = await reader.singletons.profile.read();
const stats = hero?.stats ?? [
  { emoji: "🚀", label: "3+ Production Projects" },
  { emoji: "⚙️", label: "REST API" },
  { emoji: "🐘", label: "PostgreSQL" },
  { emoji: "🐳", label: "Docker" },
];

const en = hero?.en;
const id = hero?.id;
const softwareHouseName = profile?.softwareHouseName ?? "Surupan Software House";
const softwareHouseShortName = profile?.softwareHouseShortName ?? "SSH";
const softwareHouseUrl = profile?.softwareHouseUrl ?? "#";
---

<section id="hero" class="min-h-[100svh] flex flex-col justify-center relative overflow-hidden pt-28 pb-16 md:pt-24 md:pb-20">
    <!-- Subtle gradient orb -->
    <div class="hero-orb absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="orb"></div>
    </div>

    <div class="hero-stagger hero-inner w-full max-w-none md:max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16 flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-8">
        <div class="flex-1 space-y-8 md:space-y-10 relative z-10 w-full pl-0">
            <!-- Role / Tagline Badges -->
            <div class="flex flex-wrap items-center gap-2.5 md:gap-3">
                <div class="inline-flex max-w-full items-center gap-2 px-3 py-2 sm:px-4 rounded-full bg-primary/10 border border-primary/20 transition-all duration-300 cursor-default">
                    <span class="w-2 h-2 rounded-full bg-green-500"></span>
                    <span class="text-[11px] sm:text-sm font-bold tracking-widest text-primary uppercase">
                        <span data-lang="en">{en?.badge ?? "Available for new opportunities"}</span>
                        <span data-lang="id" hidden>{id?.badge ?? "Terbuka untuk kolaborasi"}</span>
                    </span>
                </div>
                <a href={softwareHouseUrl} target={softwareHouseUrl === "#" ? undefined : "_blank"} rel={softwareHouseUrl === "#" ? undefined : "noopener noreferrer"} class="inline-flex max-w-full items-center gap-2 rounded-full border border-border bg-card/80 px-3 py-2 sm:px-3.5 text-xs sm:text-sm font-semibold text-foreground/80 shadow-sm backdrop-blur-xl hover:border-border hover:text-foreground transition-all duration-300">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-accent/10 text-accent">
                        <Building2 className="h-3.5 w-3.5" />
                    </span>
                    <span class="font-extrabold text-accent">{softwareHouseShortName}</span>
                    <span class="hidden h-1 w-1 rounded-full bg-muted-foreground/40 sm:block"></span>
                    <span class="truncate" data-lang="en">Founder, {softwareHouseName}</span>
                    <span class="truncate" data-lang="id" hidden>Founder, {softwareHouseName}</span>
                </a>
            </div>

            <!-- Main Headline -->
            <div class="space-y-6">
                <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight text-foreground leading-[1.1]">
                    <span class="block">
                        <span data-lang="en">{en?.title1 ?? "Fullstack Developer"}</span>
                        <span data-lang="id" hidden>{id?.title1 ?? "Fullstack Developer"}</span>
                    </span>
                    <span class="block text-primary mt-2 text-3xl sm:text-4xl md:text-5xl">
                        <span data-lang="en">{en?.title2 ?? "(Next.js + Laravel + Go)"}</span>
                        <span data-lang="id" hidden>{id?.title2 ?? "(Next.js + Laravel + Go)"}</span>
                    </span>
                </h1>

                <p class="hero-subtitle text-lg md:text-2xl text-muted-foreground max-w-2xl leading-relaxed font-light">
                    <span data-lang="en">{en?.subtitle ?? "I Build Scalable Backend Systems That Handle Real-World Traffic."}</span>
                    <span data-lang="id" hidden>{id?.subtitle ?? "Saya Membangun Sistem Backend Skalabel yang Tahan Beban Produksi."}</span>
                </p>

                <!-- Quick Stats -->
                <div class="flex flex-wrap gap-2.5 sm:gap-4 pt-1 pb-2 md:pt-2 md:pb-4">
                    {stats.map((stat) => (
                        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-card border border-border">
                            <span class="text-sm">{stat.emoji}</span>
                            <span class="text-xs font-medium text-foreground/70">{stat.label}</span>
                        </div>
                    ))}
                </div>
            </div>

            <!-- CTA Section -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mt-4">
                <a href="#contact" onclick="event.preventDefault(); window.lenis && window.lenis.scrollTo('#contact', {offset: -80});" class="inline-flex items-center justify-center whitespace-nowrap rounded-md h-[52px] w-full sm:w-auto px-8 text-[15px] btn-gradient-glow text-white font-extrabold tracking-wide">
                    <span data-lang="en">{en?.ctaContact ?? "Hire Me"}</span>
                    <span data-lang="id" hidden>{id?.ctaContact ?? "Mari Bekerja Bersama"}</span>
                    <Mail className="ml-2 w-[18px] h-[18px]" />
                </a>
                <a href="#projects" onclick="event.preventDefault(); window.lenis && window.lenis.scrollTo('#projects', {offset: -80});" class="inline-flex items-center justify-center whitespace-nowrap rounded-md h-[52px] w-full sm:w-auto px-8 text-[15px] border border-border text-foreground hover:bg-secondary hover:-translate-y-0.5 transition-all duration-300 shadow-sm font-medium bg-card/50">
                    <span data-lang="en">{en?.ctaProjects ?? "Projects"}</span>
                    <span data-lang="id" hidden>{id?.ctaProjects ?? "Proyek"}</span>
                    <ArrowRight className="ml-2 w-[18px] h-[18px]" />
                </a>
            </div>
        </div>

        <!-- Right Side Code Card -->
        <div class="hidden lg:block flex-1 w-full max-w-xl relative opacity-90 overflow-hidden" data-reveal data-reveal-delay="0.3">
            <div class="bg-card/70 border border-border rounded-2xl p-8 shadow-lg rotate-2 hover:rotate-0 hover:scale-[1.01] transition-all duration-500 group">
                <div class="flex items-center justify-between mb-8 border-b border-border pb-4">
                    <div class="flex gap-2">
                        <div class="w-3.5 h-3.5 rounded-full bg-red-500/80"></div>
                        <div class="w-3.5 h-3.5 rounded-full bg-yellow-500/80"></div>
                        <div class="w-3.5 h-3.5 rounded-full bg-green-500/80"></div>
                    </div>
                    <div class="text-xs text-muted-foreground font-mono tracking-widest uppercase">focus.ts</div>
                </div>

                <div class="space-y-4 font-mono text-sm sm:text-base leading-relaxed text-foreground/70">
                    <div class="flex">
                        <span class="text-accent mr-2">const</span>
                        <span class="text-primary">fokusUtama</span>
                        <span class="mx-2 text-muted-foreground/30">=</span>
                        <span class="text-foreground/60">{`{`}</span>
                    </div>
                    <div class="pl-6 flex flex-col gap-2">
                        <div>
                            <span class="text-muted-foreground mr-2">role:</span>
                            <span class="text-green-600/80 dark:text-green-400/80">
                                <span data-lang="en">{en?.codeRole ?? '"Solving architecture bottlenecks"'}</span>
                                <span data-lang="id" hidden>{id?.codeRole ?? '"Menyelesaikan bottleneck arsitektur"'}</span>
                            </span><span class="text-muted-foreground/30">,</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground mr-2">skillUtama:</span>
                            <span class="text-foreground/60">[</span><span class="text-orange-600/80 dark:text-orange-400/80">
                                <span data-lang="en">{en?.codeSkill1 ?? '"Backend"'}</span>
                                <span data-lang="id" hidden>{id?.codeSkill1 ?? '"Backend API"'}</span>
                            </span><span class="text-muted-foreground/30">, </span><span class="text-orange-600/80 dark:text-orange-400/80">
                                <span data-lang="en">{en?.codeSkill2 ?? '"Cloud Deployments"'}</span>
                                <span data-lang="id" hidden>{id?.codeSkill2 ?? '"Cloud Deployments"'}</span>
                            </span><span class="text-foreground/60">]</span><span class="text-muted-foreground/30">,</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground mr-2">impact:</span>
                            <span class="text-green-600/80 dark:text-green-400/80">
                                <span data-lang="en">{en?.codeImpact ?? '"Faster business operations"'}</span>
                                <span data-lang="id" hidden>{id?.codeImpact ?? '"Proses bisnis lebih cepat"'}</span>
                            </span><span class="text-muted-foreground/30">,</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground mr-2">delivery:</span>
                            <span class="text-accent/80">
                                <span data-lang="en">{en?.codeDelivery ?? '"On Time & Robust"'}</span>
                                <span data-lang="id" hidden>{id?.codeDelivery ?? '"Tepat Waktu & Tangguh"'}</span>
                            </span>
                        </div>
                    </div>
                    <div class="flex mt-2">
                        <span class="text-foreground/60">{`}`}</span><span class="text-muted-foreground/30">;</span>
                    </div>

                    <div class="flex mt-6 items-center gap-3 pt-6 border-t border-border opacity-50 group-hover:opacity-100 transition-opacity">
                        <span class="w-2 h-2 rounded-full bg-green-500"></span>
                        <span class="text-xs text-foreground/60 uppercase tracking-widest font-semibold flex-1">System is running securely</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-60">
        <span class="text-[10px] font-medium tracking-widest uppercase text-muted-foreground">Scroll</span>
        <div class="w-5 h-8 rounded-full border-2 border-muted-foreground/40 flex justify-center pt-1.5">
            <div class="w-1 h-2 rounded-full bg-primary animate-bounce"></div>
        </div>
    </div>
</section>

<script>
    import { haptic } from '../utils/haptic';
    document.querySelectorAll('#hero a[href^="#"], #hero a[href*="wa.me"]').forEach(el => {
        el.addEventListener('click', () => haptic('medium'));
    });
</script>

<style>
    .hero-orb {
        position: absolute;
        inset: 0;
    }
    .orb {
        position: absolute;
        width: 600px;
        height: 600px;
        top: -15%;
        right: -5%;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.12;
        background: radial-gradient(ellipse, rgba(59, 130, 246, 0.6) 0%, transparent 70%);
        animation: orb-drift 20s ease-in-out infinite alternate;
        will-change: transform;
    }
    @keyframes orb-drift {
        0%   { transform: translate(0, 0) scale(1); }
        50%  { transform: translate(-30px, 20px) scale(1.05); }
        100% { transform: translate(10px, -15px) scale(0.97); }
    }
    @media (prefers-reduced-motion: reduce) {
      .orb { animation: none; }
    }
</style>
