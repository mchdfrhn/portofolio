<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Splitting from 'splitting';
  import 'splitting/dist/splitting.css';
  import 'splitting/dist/splitting-cells.css';

  gsap.registerPlugin(ScrollTrigger);

  let lenis: Lenis | null = null;
  let ctx: gsap.Context | null = null;
  let anchorHandler: ((e: Event) => void) | null = null;

  const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Smooth Scroll ── */
  const initSmoothScroll = (): Lenis => {
    const l = new Lenis({
      lerp: isReduced ? 1 : 0.1,        // instant if reduced motion
      smoothWheel: !isReduced,
      wheelMultiplier: 1.0,
    });

    // Single ticker loop — GSAP drives Lenis
    gsap.ticker.add((time) => {
      l.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    // ScrollTrigger ↔ Lenis sync
    l.on('scroll', ScrollTrigger.update);

    // Anchor click delegation
    anchorHandler = (e: Event) => {
      const target = (e.target as Element).closest('a');
      if (!target) return;
      const href = target.getAttribute('href');
      if (href?.startsWith('#') && href !== '#') {
        e.preventDefault();
        l.scrollTo(href, { offset: -80 });
      }
    };
    document.addEventListener('click', anchorHandler);

    // Reset scroll on first visit only
    if (!document.documentElement.classList.contains('is-loaded')) {
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      l.scrollTo(0, { immediate: true });
      document.documentElement.classList.add('is-loaded');
    }

    return l;
  };

  /* ── GSAP Animations (wrapped in context for cleanup) ── */
  const initAnimations = (): gsap.Context => {
    return gsap.context(() => {
      if (isReduced) return; // skip all animations

      // Scroll reveal — individual [data-reveal] elements
      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        const delay = parseFloat(el.dataset.revealDelay ?? '0');
        gsap.from(el, {
          y: 50,
          opacity: 0,
          duration: 0.85,
          delay,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            toggleActions: 'play none none none',
          },
        });
      });

      // Stagger reveal — [data-reveal-stagger] containers
      gsap.utils.toArray<HTMLElement>('[data-reveal-stagger]').forEach((container) => {
        const items = container.querySelectorAll<HTMLElement>('[data-reveal-item]');
        if (!items.length) return;
        gsap.from(items, {
          y: 40,
          opacity: 0,
          duration: 0.7,
          stagger: 0.08,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: container,
            start: 'top 88%',
            toggleActions: 'play none none none',
          },
        });
      });

      // Text split char animation — [data-splitting] elements
      gsap.utils.toArray<HTMLElement>('[data-splitting]').forEach((el) => {
        const chars = el.querySelectorAll<HTMLElement>('.char');
        if (!chars.length) return;
        gsap.from(chars, {
          opacity: 0,
          y: 18,
          duration: 0.55,
          stagger: 0.018,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 92%',
            toggleActions: 'play none none none',
          },
        });
      });

      // Magnetic buttons — .magnetic elements
      gsap.utils.toArray<HTMLElement>('.magnetic').forEach((btn) => {
        const onMove = (e: MouseEvent) => {
          const rect = btn.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          gsap.to(btn, {
            x: (e.clientX - cx) * 0.4,
            y: (e.clientY - cy) * 0.4,
            duration: 0.3,
            ease: 'power2.out',
          });
        };
        const onLeave = () => {
          gsap.to(btn, {
            x: 0,
            y: 0,
            duration: 0.6,
            ease: 'elastic.out(1, 0.5)',
          });
        };
        btn.addEventListener('mousemove', onMove);
        btn.addEventListener('mouseleave', onLeave);
      });

      // ── Section gradient background shift ──
      const sections = gsap.utils.toArray<HTMLElement>('section[id]');
      sections.forEach((section) => {
        gsap.to(section, {
          '--section-progress': 1,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        });
      });

      // ── Project showcase: staggered scale-in + parallax images ──
      const projectCards = gsap.utils.toArray<HTMLElement>('#projects [data-cursor="view"]');
      if (projectCards.length) {
        projectCards.forEach((card, i) => {
          // Scale-in entrance
          gsap.from(card, {
            scale: 0.92,
            opacity: 0,
            y: 40,
            duration: 0.8,
            delay: i * 0.12,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: card,
              start: 'top 90%',
              toggleActions: 'play none none none',
            },
          });

          // Parallax on project images
          const img = card.querySelector('img');
          if (img) {
            gsap.to(img, {
              y: -20,
              ease: 'none',
              scrollTrigger: {
                trigger: card,
                start: 'top bottom',
                end: 'bottom top',
                scrub: 1.5,
              },
            });
          }
        });
      }
    });
  };

  /* ── Boot Sequence ── */
  const boot = () => {
    Splitting();
    lenis = initSmoothScroll();
    ctx = initAnimations();
    (window as any).lenis = lenis;
  };

  // Initial load
  boot();

  // Astro View Transitions — full cleanup + re-init
  document.addEventListener('astro:after-swap', () => {
    // Kill all GSAP animations + ScrollTrigger instances
    ctx?.revert();
    ctx = null;

    // Destroy Lenis
    if (lenis) {
      if (anchorHandler) document.removeEventListener('click', anchorHandler);
      lenis.destroy();
      lenis = null;
    }

    // Re-boot
    boot();
    ScrollTrigger.refresh();
  });

  document.addEventListener('astro:before-swap', () => {
    ctx?.revert();
    ctx = null;
  });
</script>

<style is:global>
  html.lenis {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }
  .lenis.lenis-stopped {
    overflow: hidden;
  }
  .lenis.lenis-scrolling iframe {
    pointer-events: none;
  }
  .splitting {
    display: inline-block;
  }
  [data-splitting] .word {
    display: inline-block;
    overflow: hidden;
  }
  [data-splitting] .char {
    display: inline-block;
    will-change: transform, opacity;
  }
</style>
