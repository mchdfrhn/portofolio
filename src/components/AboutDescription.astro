---
import { reader } from "@/lib/reader";
import { ExpertiseGrid } from "./ExpertiseGrid";

const about = await reader.singletons.about.read();
const rawExpertise = await reader.collections.expertise.all();
const expertise = rawExpertise
  .sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0))
  .map(({ slug, entry }) => ({
    slug,
    icon: entry.icon,
    colorTheme: entry.colorTheme,
    fullWidth: entry.fullWidth,
    tech: [...entry.tech],
    en: entry.en,
    id: entry.id,
  }));
---

<section id="about-description" class="pb-12 md:pb-16">
    <div class="mb-10 md:mb-12">
        <span class="text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full bg-primary-neon/10 text-primary-neon border border-primary-neon/20 mb-6 inline-block" data-reveal>
            <span data-lang="en">{about?.en.expertiseBadge ?? "Expertise"}</span>
            <span data-lang="id" hidden>{about?.id.expertiseBadge ?? "Keahlian"}</span>
        </span>
        <h2 class="text-3xl md:text-5xl font-extrabold mb-6 tracking-tight text-foreground" data-reveal data-reveal-delay="0.1">
            <span data-lang="en">{about?.en.expertiseHeading ?? "What I Do"}</span>
            <span data-lang="id" hidden>{about?.id.expertiseHeading ?? "Apa yang Saya Lakukan"}</span>
        </h2>
        <div class="h-1.5 w-24 bg-primary-neon rounded-full shadow-[0_0_15px_rgba(56,189,248,0.5)] mb-8" data-reveal data-reveal-delay="0.15"></div>
        <p class="text-lg md:text-xl text-foreground/80 max-w-3xl leading-relaxed font-light" data-reveal data-reveal-delay="0.2">
            <span data-lang="en">{about?.en.expertiseLead ?? "As a dedicated Fullstack Developer, I am passionate about building efficient and scalable digital solutions. I have extensive experience managing the entire development lifecycle, from code to production, ensuring systems run reliably and optimally."}</span>
            <span data-lang="id" hidden>{about?.id.expertiseLead ?? "Saya percaya bahwa software yang baik bukan cuma soal fitur, tapi juga soal bagaimana dia jalan di produksi - stabil, cepat, dan mudah di-maintain. Dari nulis kode sampai deploy ke cloud, saya ikut pegang semua prosesnya."}</span>
        </p>
    </div>

    <ExpertiseGrid client:visible expertise={expertise} />

    <div class="mt-8 p-6 md:p-8 rounded-2xl border border-primary-neon/20 bg-primary-neon/5 backdrop-blur-md shadow-inner" data-reveal data-reveal-delay="0.1">
        <p class="text-foreground/80 leading-relaxed font-medium">
            <span data-lang="en">{about?.en.expertiseNote ?? "I am always open to discussing emerging technologies and exciting challenges. Feel free to reach out to explore how I can bring value to your team through efficient development practices, robust infrastructure, and innovative solutions."}</span>
            <span data-lang="id" hidden>{about?.id.expertiseNote ?? "Kalau kamu punya tantangan teknis yang menarik atau butuh orang yang ngerti dari sisi code sekaligus infrastruktur - yuk ngobrol."}</span>
        </p>
    </div>
</section>
