---
// A page section styled like a sheet in a drawing set: numbered label + rule.
import Bi from './Bi.astro'

interface Props {
  id: string
  no: string
  en: string
  idLabel: string
}
const { id, no, en, idLabel } = Astro.props
---
<section id={id} data-m-sheet class="scroll-mt-20 py-14 sm:py-20">
  <div class="relative mb-8 flex items-baseline gap-3 pb-2 font-mono text-xs uppercase tracking-[0.14em]">
    <span data-m-rule aria-hidden="true" class="absolute inset-x-0 bottom-0 h-px bg-foreground/80"></span>
    <span data-m-label class="text-primary">{no}</span>
    <h2 data-m-label class="text-foreground"><Bi en={en} id={idLabel} /></h2>
  </div>
  <slot />
</section>
