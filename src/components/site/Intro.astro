---
import Bi from './Bi.astro'
import { reader } from '@/lib/reader'
import { GITHUB_URL, LINKEDIN_URL, EMAIL } from '@/lib/config'

const profile = await reader.singletons.profile.read()
const location = profile?.location ?? 'Jakarta'
const links = [
  { href: GITHUB_URL, label: 'GitHub' },
  { href: LINKEDIN_URL, label: 'LinkedIn' },
  { href: `mailto:${EMAIL}`, label: 'Email' },
]
const rows = [
  { k: ['Now', 'Sekarang'], v: ['Software Engineer (Fullstack), STT Pekerjaan Umum Jakarta', 'Software Engineer (Fullstack), STT Pekerjaan Umum Jakarta'] },
  { k: ['Also', 'Juga'], v: ['Founder, Surupan Software House', 'Founder, Surupan Software House'] },
  { k: ['Studying', 'Kuliah'], v: ['Informatics Engineering, STT PU (2023–)', 'Teknik Informatika, STT PU (2023–)'] },
  { k: ['Based', 'Lokasi'], v: [location, location] },
]
---
<section class="pb-8 pt-16 sm:pt-24">
  <p class="mb-6 font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">
    Mochammad Farhan Ali — Fullstack Developer
  </p>
  <h1 class="font-serif text-[2.6rem] leading-[1.05] tracking-tight sm:text-6xl">
    <Bi
      en="I build the software public institutions run on."
      id="Saya membangun software yang menjalankan institusi publik."
    />
  </h1>
  <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
    <Bi
      en="I'm Farhan. For the past year and a half I've been building academic and HR systems for a public-works college and the Ministry of Public Works — with TypeScript, Next.js, Go and PostgreSQL, from the database schema to the deploy."
      id="Saya Farhan. Satu setengah tahun terakhir saya membangun sistem akademik dan kepegawaian untuk kampus pekerjaan umum dan Kementerian Pekerjaan Umum — dengan TypeScript, Next.js, Go, dan PostgreSQL, dari skema database sampai deploy."
    />
  </p>

  <dl class="mt-10 grid max-w-xl grid-cols-[6.5rem_1fr] gap-y-2 border-t border-border pt-4 text-sm">
    {rows.map((row) => (
      <>
        <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground pt-0.5"><Bi en={row.k[0]} id={row.k[1]} /></dt>
        <dd><Bi en={row.v[0]} id={row.v[1]} /></dd>
      </>
    ))}
  </dl>

  <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
    <a href="/cv-en.pdf" data-lang="en" download class="inline-flex items-center gap-2 rounded-sm bg-foreground px-4 py-2 font-medium text-background transition-colors hover:bg-primary hover:text-primary-foreground">
      Download CV ↓
    </a>
    <a href="/cv-id.pdf" data-lang="id" download class="inline-flex items-center gap-2 rounded-sm bg-foreground px-4 py-2 font-medium text-background transition-colors hover:bg-primary hover:text-primary-foreground">
      Unduh CV ↓
    </a>
    {links.map((l) => (
      <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="link">{l.label}</a>
    ))}
  </div>
</section>
