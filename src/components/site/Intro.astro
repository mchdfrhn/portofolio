---
import Bi from './Bi.astro'
import { getProfile, getHero } from '@/lib/site-content'

const [profile, hero] = await Promise.all([getProfile(), getHero()])
const location = profile?.location ?? ''
const links = [
  profile?.github && { href: profile.github, label: 'GitHub' },
  profile?.linkedin && { href: profile.linkedin, label: 'LinkedIn' },
  profile?.email && { href: `mailto:${profile.email}`, label: 'Email' },
].filter((l): l is { href: string; label: string } => Boolean(l))
const rows = [
  ...(hero?.facts ?? []).map((f) => ({ k: [f.en.label, f.id.label], v: [f.en.value, f.id.value], href: f.href ?? undefined })),
  ...(location ? [{ k: ['Based', 'Lokasi'], v: [location, location], href: undefined }] : []),
]
const domain = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '')
---
<section data-m-intro class="pb-8 pt-16 sm:pt-24">
  <p data-m-step class="mb-6 font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">
    {profile?.name ?? ''} — <Bi en={profile?.titleEn ?? ''} id={profile?.titleId ?? ''} />
  </p>
  <h1 data-m-step data-m-split class="font-serif text-[2.6rem] leading-[1.05] tracking-tight sm:text-6xl">
    <Bi en={hero?.en.headline ?? ''} id={hero?.id.headline ?? ''} />
  </h1>
  <p data-m-step class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
    <Bi en={hero?.en.intro ?? ''} id={hero?.id.intro ?? ''} />
  </p>

  <div data-m-step data-m-rule aria-hidden="true" class="mt-10 h-px max-w-xl bg-border"></div>
  <dl data-m-step class="grid max-w-xl grid-cols-[6.5rem_1fr] gap-y-2 pt-4 text-sm">
    {rows.map((row) => (
      <>
        <dt class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground pt-0.5"><Bi en={row.k[0]} id={row.k[1]} /></dt>
        <dd>
          {row.href ? (
            <a href={row.href} target="_blank" rel="noopener noreferrer" class="group inline-flex flex-wrap items-baseline gap-x-2">
              <span class="link group-hover:text-primary group-hover:decoration-primary"><Bi en={row.v[0]} id={row.v[1]} /></span>
              <span class="font-mono text-xs text-muted-foreground transition-colors group-hover:text-primary">
                {domain(row.href)} <span aria-hidden="true" class="inline-block transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
              </span>
            </a>
          ) : (
            <Bi en={row.v[0]} id={row.v[1]} />
          )}
        </dd>
      </>
    ))}
  </dl>

  <div data-m-step class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
    <a href="/cv-en.pdf" data-lang="en" download class="inline-flex items-center gap-2 rounded-sm bg-foreground px-4 py-2 font-medium text-background transition-colors hover:bg-primary hover:text-primary-foreground">
      Download CV ↓
    </a>
    <a href="/cv-id.pdf" data-lang="id" download class="inline-flex items-center gap-2 rounded-sm bg-foreground px-4 py-2 font-medium text-background transition-colors hover:bg-primary hover:text-primary-foreground">
      Unduh CV ↓
    </a>
    {links.map((l) => (
      <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="link">{l.label}</a>
    ))}
  </div>
</section>
