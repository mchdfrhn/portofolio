---
import Bi from './Bi.astro'
import Sheet from './Sheet.astro'
import ProjectCard from './ProjectCard.astro'
import { getProjects, HOME_PROJECT_LIMIT } from '@/lib/projects'

const projects = await getProjects()
const shown = projects.slice(0, HOME_PROJECT_LIMIT)
---
<Sheet id="work" no="02" en="Selected work" idLabel="Proyek pilihan">
  <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2">
    {shown.map(({ slug, entry }) => <ProjectCard slug={slug} entry={entry} />)}
  </ul>
  {projects.length > HOME_PROJECT_LIMIT && (
    <p class="mt-10 text-sm">
      <a href="/projects" class="link font-medium"><Bi en="See all projects →" id="Lihat semua proyek →" /></a>
    </p>
  )}
</Sheet>
