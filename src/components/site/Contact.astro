---
import Bi from './Bi.astro'
import Sheet from './Sheet.astro'
import { EMAIL, WHATSAPP_URL } from '@/lib/config'

const field = 'w-full rounded-sm border border-input bg-background px-3 py-2 text-base outline-none transition-colors focus:border-primary'
const label = 'mb-1 block font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground'
---
<Sheet id="contact" no="04" en="Contact" idLabel="Kontak">
  <p class="max-w-xl font-serif text-3xl leading-tight sm:text-4xl">
    <Bi
      en="Got a process that still runs on spreadsheets? Let's talk."
      id="Punya proses yang masih jalan di spreadsheet? Ayo ngobrol."
    />
  </p>
  <p class="mt-4 max-w-xl text-muted-foreground">
    <Bi
      en="I'm open to full-time roles and freelance projects. Email is fastest:"
      id="Saya terbuka untuk posisi full-time dan proyek freelance. Paling cepat lewat email:"
    />
    {' '}<a href={`mailto:${EMAIL}`} class="link text-foreground">{EMAIL}</a>
    <Bi en=" — or " id=" — atau " />
    <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="link text-foreground">WhatsApp</a>.
  </p>

  <form id="contact-form" action="/api/contact" method="POST" class="mt-10 grid max-w-xl gap-5">
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <div class="grid gap-5 sm:grid-cols-2">
      <label class="block">
        <span class={label}><Bi en="Name" id="Nama" /></span>
        <input name="name" required autocomplete="name" class={field} />
      </label>
      <label class="block">
        <span class={label}>Email</span>
        <input name="email" type="email" required autocomplete="email" class={field} />
      </label>
    </div>
    <label class="block">
      <span class={label}><Bi en="Message" id="Pesan" /></span>
      <textarea name="message" required rows="5" class={field}></textarea>
    </label>
    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="rounded-sm bg-foreground px-5 py-2 text-sm font-medium text-background transition-colors hover:bg-primary hover:text-primary-foreground disabled:opacity-50">
        <Bi en="Send message" id="Kirim pesan" />
      </button>
      <p data-status="sending" hidden class="text-sm text-muted-foreground"><Bi en="Sending…" id="Mengirim…" /></p>
      <p data-status="success" hidden class="text-sm text-primary"><Bi en="Sent. I'll reply soon." id="Terkirim. Saya akan segera membalas." /></p>
      <p data-status="error" hidden role="alert" class="text-sm text-destructive"><Bi en="Couldn't send right now — please email me instead." id="Belum bisa terkirim — silakan email saya langsung." /></p>
    </div>
  </form>
</Sheet>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')
  const show = (status: string | null) => {
    form?.querySelectorAll<HTMLElement>('[data-status]').forEach((el) => {
      el.hidden = el.dataset.status !== status
    })
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const button = form.querySelector('button')
    if (button) button.disabled = true
    show('sending')
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
      if (!res.ok) throw new Error('Contact request failed')
      form.reset()
      show('success')
    } catch {
      show('error')
    } finally {
      if (button) button.disabled = false
    }
  })
</script>
