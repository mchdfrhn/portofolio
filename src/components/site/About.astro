---
import Bi from './Bi.astro'
import Sheet from './Sheet.astro'
import CommitLog from './CommitLog.astro'
import { reader } from '@/lib/reader'
import { getAbout, getProfile } from '@/lib/site-content'

const expertise = (await reader.collections.expertise.all())
  .sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99))

const about = await getAbout()
// Read at build time: the server island runs in a serverless function without the content/ files
const githubUrl = (await getProfile())?.github ?? ''
const story = (about?.en.story ?? []).map((en, i) => ({ en, id: about?.id.story[i] ?? en }))
const principles = about?.principles ?? []
---
<Sheet id="about" no="01" en="About" idLabel="Tentang">
  <div class="max-w-2xl space-y-5 text-[1.0625rem] leading-relaxed">
    {story.map((p) => (
      <p data-m-reveal><Bi en={p.en} id={p.id} /></p>
    ))}
  </div>

  <h3 class="mb-4 mt-14 font-serif text-2xl"><Bi en="How I work" id="Cara saya bekerja" /></h3>
  <ol class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
    {principles.map((p, i) => (
      <li data-m-reveal class="border-t border-border pt-3">
        <p class="font-medium">
          <span class="mr-2 font-mono text-xs text-primary">{String(i + 1).padStart(2, '0')}</span>
          <Bi en={p.en.title} id={p.id.title} />
        </p>
        <p class="mt-1 text-sm leading-relaxed text-muted-foreground"><Bi en={p.en.body} id={p.id.body} /></p>
      </li>
    ))}
  </ol>

  <h3 class="mb-4 mt-14 font-serif text-2xl"><Bi en="Toolbox" id="Peralatan" /></h3>
  <dl class="divide-y divide-border border-y border-border text-sm">
    {expertise.map(({ entry }) => (
      <div data-m-reveal class="grid gap-1 py-3 sm:grid-cols-[12rem_1fr] sm:gap-4">
        <dt class="font-medium"><Bi en={entry.en.title ?? entry.name} id={entry.id.title ?? entry.name} /></dt>
        <dd class="font-mono text-[13px] text-muted-foreground">{entry.tech.join(' · ')}</dd>
      </div>
    ))}
  </dl>

  <h3 class="mt-14 font-serif text-2xl"><Bi en="Commit log" id="Log commit" /></h3>
  <p class="mb-4 mt-1 text-sm text-muted-foreground"><Bi en="Contributions on GitHub over the past year" id="Kontribusi di GitHub selama setahun terakhir" /></p>
  <div class="border-y border-border py-5">
    <CommitLog server:defer githubUrl={githubUrl}>
      <p slot="fallback" class="h-[115px] font-mono text-xs text-muted-foreground"><Bi en="Loading…" id="Memuat…" /></p>
    </CommitLog>
  </div>
</Sheet>
