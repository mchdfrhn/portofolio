---
const services = {
  en: {
    badge: "What I Offer",
    title: "Fullstack development from code to production",
    description:
      "I build complete web applications — from database design and backend APIs to frontend UI and cloud deployment.",
    cta: "Get in Touch",
    items: [
      {
        title: "Web Application Development",
        description:
          "Build scalable fullstack apps with Next.js, React, or Laravel — complete with authentication, database, and responsive UI.",
        points: ["Fullstack (Next.js, React, Laravel)", "PostgreSQL, MySQL, MongoDB", "Responsive & accessible UI"],
      },
      {
        title: "Backend & API Development",
        description:
          "Design and build REST APIs with Go (Gin), Node.js, or Express — structured, validated, and production-ready.",
        points: ["Go (Gin), Node.js, Express.js", "JWT auth & input validation", "Database schema design"],
      },
      {
        title: "DevOps & Deployment",
        description:
          "Set up Docker environments, CI/CD pipelines, and cloud infrastructure so your app runs reliably in production.",
        points: ["Docker & containerization", "GitHub Actions, Jenkins CI/CD", "AWS, Vercel, cloud deployment"],
      },
    ],
  },
  id: {
    badge: "Yang Saya Tawarkan",
    title: "Fullstack development dari kode ke produksi",
    description:
      "Saya membangun aplikasi web lengkap — dari desain database dan backend API hingga frontend UI dan deployment ke cloud.",
    cta: "Hubungi Saya",
    items: [
      {
        title: "Pengembangan Aplikasi Web",
        description:
          "Membangun aplikasi fullstack yang skalabel dengan Next.js, React, atau Laravel — lengkap dengan autentikasi, database, dan UI responsif.",
        points: ["Fullstack (Next.js, React, Laravel)", "PostgreSQL, MySQL, MongoDB", "UI responsif & aksesibel"],
      },
      {
        title: "Backend & API Development",
        description:
          "Merancang dan membangun REST API dengan Go (Gin), Node.js, atau Express — terstruktur, tervalidasi, dan siap produksi.",
        points: ["Go (Gin), Node.js, Express.js", "Autentikasi JWT & validasi input", "Desain skema database"],
      },
      {
        title: "DevOps & Deployment",
        description:
          "Menyiapkan environment Docker, pipeline CI/CD, dan infrastruktur cloud agar aplikasi berjalan stabil di produksi.",
        points: ["Docker & kontainerisasi", "GitHub Actions, Jenkins CI/CD", "AWS, Vercel, deployment cloud"],
      },
    ],
  },
};
---

<section id="services" class="relative py-20 md:py-32" data-reveal>
  <div class="mb-10 max-w-3xl md:mb-16">
    <div class="inline-block mb-4">
      <span class="text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full bg-accent/10 text-accent border border-accent/20">
        <span data-lang="en">{services.en.badge}</span>
        <span data-lang="id" hidden>{services.id.badge}</span>
      </span>
    </div>
    <h2 class="text-4xl md:text-6xl font-extrabold mb-6 text-foreground tracking-tight">
      <span data-lang="en">{services.en.title}</span>
      <span data-lang="id" hidden>{services.id.title}</span>
    </h2>
    <div class="mb-6 h-1 w-20 rounded-full bg-accent md:mb-8"></div>
    <p class="text-muted-foreground text-lg md:text-xl leading-relaxed">
      <span data-lang="en">{services.en.description}</span>
      <span data-lang="id" hidden>{services.id.description}</span>
    </p>
  </div>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-8">
    {services.en.items.map((service, index) => {
      const serviceId = services.id.items[index];
      return (
        <article class="group flex h-full flex-col rounded-xl border border-border bg-card p-6 transition-all duration-300 hover:-translate-y-1 lg:p-8">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-xl font-black text-primary">
            0{index + 1}
          </div>
          <h3 class="mb-3 text-xl font-bold text-foreground sm:text-2xl">
            <span data-lang="en">{service.title}</span>
            <span data-lang="id" hidden>{serviceId.title}</span>
          </h3>
          <p class="mb-6 text-sm leading-relaxed text-muted-foreground">
            <span data-lang="en">{service.description}</span>
            <span data-lang="id" hidden>{serviceId.description}</span>
          </p>
          <ul class="mt-auto space-y-2 border-t border-border pt-5">
            {service.points.map((point, pointIndex) => (
              <li class="flex items-center gap-2 text-sm font-medium text-foreground/80">
                <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
                <span data-lang="en">{point}</span>
                <span data-lang="id" hidden>{serviceId.points[pointIndex]}</span>
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </div>

  <div class="mt-10 flex justify-center md:mt-14">
    <a href="#contact" onclick="event.preventDefault(); window.lenis && window.lenis.scrollTo('#contact', {offset: -80});" class="inline-flex h-[52px] items-center justify-center rounded-md px-8 text-[15px] font-extrabold tracking-wide text-white bg-primary hover:bg-primary/90 transition-colors">
      <span data-lang="en">{services.en.cta}</span>
      <span data-lang="id" hidden>{services.id.cta}</span>
    </a>
  </div>
</section>
