---
import { reader } from "@/lib/reader";
import { AboutBentoGrid } from "./AboutBentoGrid";

const about = await reader.singletons.about.read();
const profile = await reader.singletons.profile.read();

const techStack = profile?.techStack ?? [
  "Go",
  "Node.js",
  "PHP",
  "Gin",
  "React",
  "Next.js",
  "Laravel",
  "Tailwind",
  "PostgreSQL",
  "MySQL",
  "MongoDB",
  "Docker",
  "Kubernetes",
  "AWS",
  "Jenkins",
  "GitHub Actions",
];

const interests = about?.interests?.length
  ? about.interests
  : [
      {
        icon: "Globe",
        colorTheme: "primary",
        en: { label: "Cloud Infrastructure" },
        id: { label: "Infrastruktur Cloud" },
      },
      {
        icon: "LineChart",
        colorTheme: "secondary",
        en: { label: "CI/CD Automation" },
        id: { label: "Otomatisasi CI/CD" },
      },
      {
        icon: "Trophy",
        colorTheme: "green",
        en: { label: "System Design" },
        id: { label: "Desain Sistem" },
      },
    ];

const aboutGridCopy = {
  en: {
    currentLabel: about?.en.currentLabel ?? "Currently",
    currentTitle: about?.en.currentTitle ?? "Junior Software Engineer",
    currentCompany: about?.en.currentCompany ?? "STT Pekerjaan Umum Jakarta",
    currentDescription:
      about?.en.currentDescription ??
      "Designed and engineered SIPEKAD, an integrated academic and student information system built with Next.js and PostgreSQL, digitalizing campus services and automating previously manual bureaucratic processes.",
    techTitle: about?.en.techTitle ?? "Tech Stack",
    yearsLabel: about?.en.yearsLabel ?? "Years Coding",
  },
  id: {
    currentLabel: about?.id.currentLabel ?? "Saat ini",
    currentTitle: about?.id.currentTitle ?? "Junior Software Engineer",
    currentCompany: about?.id.currentCompany ?? "STT Pekerjaan Umum Jakarta",
    currentDescription:
      about?.id.currentDescription ??
      "Merancang dan membangun SIPEKAD, sistem informasi akademik dan kemahasiswaan terintegrasi berbasis Next.js dan PostgreSQL, yang mendigitalisasi layanan kampus dan mengotomasi proses birokrasi manual.",
    techTitle: about?.id.techTitle ?? "Stack Teknologi",
    yearsLabel: about?.id.yearsLabel ?? "Tahun Coding",
  },
};

const profileGridData = {
  name: profile?.name ?? "Farhan Ali",
  profileImage: profile?.profileImage ?? null,
  titleEn: profile?.titleEn ?? "Backend & Cloud Infrastructure",
  titleId: profile?.titleId ?? "Backend & Cloud Infrastructure",
  location: profile?.location ?? "Jakarta, ID (Remote Ready)",
  yearsExp: profile?.yearsExp ?? "3+",
  availability: profile?.availability ?? true,
  softwareHouseName: profile?.softwareHouseName ?? "Surupan Software House",
  softwareHouseShortName: profile?.softwareHouseShortName ?? "SSH",
  softwareHouseUrl: profile?.softwareHouseUrl ?? "#",
};
---

<section id="about" class="pb-6 md:pb-12" data-reveal>
    <div class="mb-12 md:mb-16 max-w-3xl">
        <div class="space-y-6">
            <div class="inline-block">
                <span class="text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full bg-primary/10 text-primary border border-primary/20">
                    <span data-lang="en">{about?.en.badge ?? "Who I Am"}</span>
                    <span data-lang="id" hidden>{about?.id.badge ?? "Siapa Saya"}</span>
                </span>
            </div>
            <h2 class="text-4xl md:text-6xl font-extrabold text-foreground tracking-tight" data-reveal data-reveal-delay="0.1">
                <span data-lang="en">{about?.en.title ?? "About Me"}</span>
                <span data-lang="id" hidden>{about?.id.title ?? "Tentang Saya"}</span>
            </h2>
            <div class="h-1 w-20 bg-primary rounded-full" data-reveal data-reveal-delay="0.15"></div>
            <p class="text-lg md:text-xl text-muted-foreground leading-relaxed font-light" data-reveal data-reveal-delay="0.2">
                <span data-lang="en">{about?.en.description ?? "Fullstack Developer and Cloud Infrastructure focused on building scalable web applications, academic systems, automation workflows, and reliable backend infrastructure."}</span>
                <span data-lang="id" hidden>{about?.id.description ?? "Fullstack Developer dan Cloud Infrastructure yang fokus membangun aplikasi web skalabel, sistem akademik, workflow automation, dan infrastruktur backend yang reliable."}</span>
            </p>
        </div>
    </div>

    <AboutBentoGrid
        client:visible
        about={aboutGridCopy}
        profile={profileGridData}
        techStack={techStack}
        interests={interests}
    />
</section>
