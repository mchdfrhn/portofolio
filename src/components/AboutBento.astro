---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { MapPin, Briefcase, Code2, LineChart, Globe, Trophy, Building2 } from "lucide-react";
import { reader } from "@/lib/reader";

const about = await reader.singletons.about.read();
const profile = await reader.singletons.profile.read();

const techStack = profile?.techStack ?? [
  'Go', 'Node.js', 'PHP', 'Gin', 'React', 'Next.js', 'Laravel', 'Tailwind',
  'PostgreSQL', 'MySQL', 'MongoDB', 'Docker', 'Kubernetes', 'AWS', 'Jenkins', 'GitHub Actions',
];
const location = profile?.location ?? "Jakarta, ID (Remote Ready)";
const yearsExp = profile?.yearsExp ?? "3+";
const softwareHouseName = profile?.softwareHouseName ?? "Surupan Software House";
const softwareHouseShortName = profile?.softwareHouseShortName ?? "SSH";
const softwareHouseUrl = profile?.softwareHouseUrl ?? "#";

const iconMap = { Globe, LineChart, Trophy } as const;
type IconName = keyof typeof iconMap;

const interestThemeMap = {
  primary: "bg-primary-neon/10 text-primary-neon",
  secondary: "bg-secondary-neon/10 text-secondary-neon",
  green: "bg-green-500/10 text-green-600 dark:text-green-400",
} as const;
type InterestTheme = keyof typeof interestThemeMap;

const interests = about?.interests?.length
  ? about.interests
  : [
      {
        icon: "Globe",
        colorTheme: "primary",
        en: { label: "Cloud Infrastructure" },
        id: { label: "Infrastruktur Cloud" },
      },
      {
        icon: "LineChart",
        colorTheme: "secondary",
        en: { label: "CI/CD Automation" },
        id: { label: "Otomatisasi CI/CD" },
      },
      {
        icon: "Trophy",
        colorTheme: "green",
        en: { label: "System Design" },
        id: { label: "Desain Sistem" },
      },
    ];
---

<section id="about" class="pb-6 md:pb-12">
    <div class="mb-12 md:mb-16 max-w-3xl">
        <div class="space-y-6">
            <div class="inline-block">
                <span class="text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full bg-primary-neon/10 text-primary-neon border border-primary-neon/20">
                    <span data-lang="en">{about?.en.badge ?? "Who I Am"}</span>
                    <span data-lang="id" hidden>{about?.id.badge ?? "Siapa Saya"}</span>
                </span>
            </div>
            <h2 class="text-4xl md:text-6xl font-extrabold text-foreground tracking-tight">
                <span data-lang="en">{about?.en.title ?? "About Me"}</span>
                <span data-lang="id" hidden>{about?.id.title ?? "Tentang Saya"}</span>
            </h2>
            <div class="h-1.5 w-24 bg-primary-neon rounded-full shadow-[0_0_15px_rgba(56,189,248,0.5)]"></div>
            <p class="text-lg md:text-xl text-muted-foreground leading-relaxed font-light">
                <span data-lang="en">{about?.en.description ?? "Fullstack Developer passionate about building efficient, scalable systems and managing entire development lifecycles. Experienced in cloud infrastructure, CI/CD automation, and high-performance applications. Currently contributing at Kementerian PU while pursuing informatics studies."}</span>
                <span data-lang="id" hidden>{about?.id.description ?? "Fullstack Developer yang senang membangun sistem efisien, skalabel, dan tahan banting - mulai dari infrastruktur cloud, CI/CD, sampai aplikasi yang benar-benar jalan di produksi. Saat ini magang di Kementerian PU sambil kuliah informatika."}</span>
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[minmax(180px,auto)]">

        <!-- Profile Block -->
        <Card className="md:col-span-1 bg-card/40 backdrop-blur-md rounded-2xl border border-border relative overflow-hidden group hover:border-primary-neon/40 hover:-translate-y-1 hover:shadow-[0_10px_30px_-10px_rgba(56,189,248,0.2)] transition-all duration-300">
            <div class="absolute inset-0 bg-gradient-to-br from-primary-neon/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <CardContent className="p-0 h-full flex flex-col relative z-10">
                <div class="h-32 w-full bg-muted/30 relative overflow-hidden">
                    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80')] bg-cover bg-center opacity-20 mix-blend-luminosity"></div>
                </div>
                <div class="px-6 pb-6 pt-0 relative flex-1 flex flex-col">
                    <div class="w-20 h-20 rounded-full bg-muted border-4 border-card -mt-10 overflow-hidden relative z-20 shadow-lg flex items-center justify-center grayscale hover:grayscale-0 transition-all duration-500">
                        <div class="absolute inset-0 bg-gradient-to-br from-primary-neon/20 to-secondary-neon/20 mix-blend-overlay"></div>
                        {profile?.profileImage
                          ? <img src={profile.profileImage} alt={profile.name ?? 'Profile'} class="w-full h-full object-cover" />
                          : <span class="text-3xl font-extrabold text-foreground/50">FA</span>
                        }
                    </div>
                    <div class="mt-4">
                        <h3 class="text-xl font-bold mb-1 text-foreground flex items-center gap-2">
                            <span>{profile?.name ?? "Farhan Ali"}</span>
                            {profile?.availability && <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>}
                        </h3>
                        <p class="text-primary-neon text-sm font-medium mb-3">
                            <span data-lang="en">{profile?.titleEn ?? "Backend & DevOps Engineer"}</span>
                            <span data-lang="id" hidden>{profile?.titleId ?? "Backend & DevOps Engineer"}</span>
                        </p>
                        <div class="flex items-center gap-1.5 text-muted-foreground text-xs font-medium bg-secondary px-2.5 py-1.5 rounded-md w-fit border border-border">
                            <MapPin className="w-3.5 h-3.5" />
                            <span>{location}</span>
                        </div>
                    </div>
                </div>
            </CardContent>
        </Card>

        <!-- Experience Block -->
        <Card className="md:col-span-2 group overflow-hidden bg-card/40 backdrop-blur-md rounded-2xl border border-border hover:border-primary-neon/40 hover:-translate-y-1 hover:shadow-lg transition-all duration-300 relative">
            <div class="absolute inset-0 bg-gradient-to-br from-secondary-neon/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <CardContent className="p-6 h-full flex flex-col justify-center relative z-10">
                 <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-secondary-neon/10 flex items-center justify-center text-secondary-neon group-hover:scale-110 transition-transform duration-300">
                        <Briefcase className="w-6 h-6" />
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest py-1.5 px-3 rounded-full bg-secondary text-foreground/80 border border-border">
                        <span data-lang="en">{about?.en.currentLabel ?? "Currently"}</span>
                        <span data-lang="id" hidden>{about?.id.currentLabel ?? "Saat ini"}</span>
                    </span>
                </div>
                <h3 class="text-2xl font-bold mb-2 text-foreground">
                    <span data-lang="en">{about?.en.currentTitle ?? "Intern Fullstack Developer"}</span>
                    <span data-lang="id" hidden>{about?.id.currentTitle ?? "Magang Fullstack Developer"}</span>
                </h3>
                <p class="text-primary-neon mb-3 font-semibold tracking-wide">
                    <span data-lang="en">{about?.en.currentCompany ?? "Pusdatin, Kementerian PU"}</span>
                    <span data-lang="id" hidden>{about?.id.currentCompany ?? "Pusdatin, Kementerian PU"}</span>
                </p>
                <p class="text-muted-foreground text-sm leading-relaxed">
                    <span data-lang="en">{about?.en.currentDescription ?? "Managing CI/CD pipelines, cloud infrastructure (AWS), containerization (Docker, Kubernetes), and building enterprise-grade administrative systems with modern web technologies."}</span>
                    <span data-lang="id" hidden>{about?.id.currentDescription ?? "Ngelola pipeline CI/CD, infrastruktur AWS, containerisasi Docker & Kubernetes, plus bangun sistem administrasi internal berbasis web modern."}</span>
                </p>
            </CardContent>
        </Card>

        <!-- Tech Stack Block -->
        <Card className="md:col-span-2 md:row-span-2 relative overflow-hidden bg-card/40 backdrop-blur-md rounded-2xl border border-border group hover:border-primary-neon/40 transition-all duration-300">
             <div class="absolute inset-0 bg-gradient-to-br from-foreground/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <CardHeader className="pt-6 px-6 relative z-10">
                <CardTitle className="flex items-center gap-2 text-foreground">
                    <Code2 className="w-6 h-6 text-primary-neon" />
                    <span>
                        <span data-lang="en">{about?.en.techTitle ?? "Tech Stack"}</span>
                        <span data-lang="id" hidden>{about?.id.techTitle ?? "Stack Teknologi"}</span>
                    </span>
                </CardTitle>
            </CardHeader>
            <CardContent className="grid grid-cols-2 sm:grid-cols-4 gap-3 p-6 pt-2 relative z-10">
                {techStack.map((tech) => (
                   <div class="flex flex-col items-center justify-center p-3 rounded-xl bg-secondary/50 hover:bg-secondary text-muted-foreground hover:text-primary-neon transition-all duration-300 border border-border hover:border-primary-neon/30 hover:-translate-y-1 hover:shadow-md">
                        <span class="font-semibold text-xs sm:text-sm transition-transform">{tech}</span>
                   </div>
               ))}
            </CardContent>
        </Card>

        <!-- Interests Block -->
        <Card className="md:col-span-1 bg-card/40 backdrop-blur-md rounded-2xl border border-border group hover:border-primary-neon/40 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
            <CardContent className="p-6 h-full flex flex-col justify-center gap-5">
                {interests.map((interest) => {
                    const IconComponent = iconMap[(interest.icon as IconName) ?? "Globe"];
                    const iconTheme = interestThemeMap[(interest.colorTheme as InterestTheme) ?? "primary"];

                    return (
                        <div class="flex items-center gap-3">
                            <div class={`p-2.5 rounded-xl ${iconTheme} group-hover:scale-110 transition-transform duration-300`}>
                                <IconComponent className="w-5 h-5" />
                            </div>
                            <span class="font-semibold text-foreground/90">
                                <span data-lang="en">{interest.en.label}</span>
                                <span data-lang="id" hidden>{interest.id.label}</span>
                            </span>
                        </div>
                    );
                })}
            </CardContent>
        </Card>

        <!-- Software House Block -->
        <Card className="md:col-span-1 relative overflow-hidden bg-card/40 backdrop-blur-md rounded-2xl border border-border group hover:border-primary-neon/40 hover:-translate-y-1 hover:shadow-[0_12px_35px_-16px_rgba(56,189,248,0.35)] transition-all duration-300">
            <div class="absolute inset-0 bg-gradient-to-br from-primary-neon/10 via-secondary-neon/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <CardContent className="p-6 h-full flex flex-col justify-between gap-5 relative z-10">
                <div class="flex items-start justify-between gap-4">
                    <div class="w-12 h-12 rounded-xl bg-primary-neon/10 flex items-center justify-center text-primary-neon group-hover:scale-110 transition-transform duration-300">
                        <Building2 className="w-6 h-6" />
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest py-1.5 px-3 rounded-full bg-secondary text-foreground/80 border border-border">{softwareHouseShortName}</span>
                </div>
                <div>
                    <h3 class="text-2xl font-bold mb-2 text-foreground">
                        <a href={softwareHouseUrl} target={softwareHouseUrl === "#" ? undefined : "_blank"} rel={softwareHouseUrl === "#" ? undefined : "noopener noreferrer"} class="hover:text-primary-neon transition-colors">
                            {softwareHouseName}
                        </a>
                    </h3>
                    <p class="text-muted-foreground text-sm leading-relaxed">
                        <span data-lang="en">My independent software studio for building reliable business systems, internal platforms, automation workflows, and cloud-ready web applications.</span>
                        <span data-lang="id" hidden>Software house independen saya untuk membangun sistem bisnis, platform internal, workflow automation, dan aplikasi web yang siap berjalan di cloud.</span>
                    </p>
                </div>
                <div class="flex flex-wrap gap-2">
                    {["Web Apps", "Internal Systems", "Automation"].map((item) => (
                        <span class="text-[11px] font-semibold text-primary-neon bg-primary-neon/10 border border-primary-neon/20 rounded-full px-2.5 py-1">{item}</span>
                    ))}
                </div>
            </CardContent>
        </Card>

        <!-- Years Exp Block -->
         <Card className="md:col-span-1 relative overflow-hidden bg-primary-neon/5 backdrop-blur-md rounded-2xl border border-primary-neon/10 group hover:border-primary-neon/40 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(56,189,248,0.15)] transition-all duration-300">
            <div class="absolute inset-0 bg-gradient-to-tr from-primary-neon/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <CardContent className="p-6 h-full flex flex-col justify-center text-center relative z-10">
                <div class="text-5xl font-extrabold text-primary-neon mb-3 tracking-tighter">{yearsExp}</div>
                <p class="text-sm text-secondary-neon font-bold uppercase tracking-widest">
                    <span data-lang="en">{about?.en.yearsLabel ?? "Years Coding"}</span>
                    <span data-lang="id" hidden>{about?.id.yearsLabel ?? "Tahun Coding"}</span>
                </p>
            </CardContent>
        </Card>

    </div>
</section>
