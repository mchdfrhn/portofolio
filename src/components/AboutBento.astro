---
import { reader } from "@/lib/reader";
import { AboutBentoGrid } from "./AboutBentoGrid";

const about = await reader.singletons.about.read();
const profile = await reader.singletons.profile.read();

const techStack = profile?.techStack ?? [
  "Go",
  "Node.js",
  "PHP",
  "Gin",
  "React",
  "Next.js",
  "Laravel",
  "Tailwind",
  "PostgreSQL",
  "MySQL",
  "MongoDB",
  "Docker",
  "Kubernetes",
  "AWS",
  "Jenkins",
  "GitHub Actions",
];

const interests = about?.interests?.length
  ? about.interests
  : [
      {
        icon: "Globe",
        colorTheme: "primary",
        en: { label: "Cloud Infrastructure" },
        id: { label: "Infrastruktur Cloud" },
      },
      {
        icon: "LineChart",
        colorTheme: "secondary",
        en: { label: "CI/CD Automation" },
        id: { label: "Otomatisasi CI/CD" },
      },
      {
        icon: "Trophy",
        colorTheme: "green",
        en: { label: "System Design" },
        id: { label: "Desain Sistem" },
      },
    ];

const aboutGridCopy = {
  en: {
    currentLabel: about?.en.currentLabel ?? "Currently",
    currentTitle: about?.en.currentTitle ?? "Intern Fullstack Developer",
    currentCompany: about?.en.currentCompany ?? "Pusdatin, Kementerian PU",
    currentDescription:
      about?.en.currentDescription ??
      "Managing CI/CD pipelines, cloud infrastructure (AWS), containerization (Docker, Kubernetes), and building enterprise-grade administrative systems with modern web technologies.",
    techTitle: about?.en.techTitle ?? "Tech Stack",
    yearsLabel: about?.en.yearsLabel ?? "Years Coding",
  },
  id: {
    currentLabel: about?.id.currentLabel ?? "Saat ini",
    currentTitle: about?.id.currentTitle ?? "Magang Fullstack Developer",
    currentCompany: about?.id.currentCompany ?? "Pusdatin, Kementerian PU",
    currentDescription:
      about?.id.currentDescription ??
      "Ngelola pipeline CI/CD, infrastruktur AWS, containerisasi Docker & Kubernetes, plus bangun sistem administrasi internal berbasis web modern.",
    techTitle: about?.id.techTitle ?? "Stack Teknologi",
    yearsLabel: about?.id.yearsLabel ?? "Tahun Coding",
  },
};

const profileGridData = {
  name: profile?.name ?? "Farhan Ali",
  profileImage: profile?.profileImage ?? null,
  titleEn: profile?.titleEn ?? "Backend & DevOps Engineer",
  titleId: profile?.titleId ?? "Backend & DevOps Engineer",
  location: profile?.location ?? "Jakarta, ID (Remote Ready)",
  yearsExp: profile?.yearsExp ?? "3+",
  availability: profile?.availability ?? true,
  softwareHouseName: profile?.softwareHouseName ?? "Surupan Software House",
  softwareHouseShortName: profile?.softwareHouseShortName ?? "SSH",
  softwareHouseUrl: profile?.softwareHouseUrl ?? "#",
};
---

<section id="about" class="pb-6 md:pb-12">
    <div class="mb-12 md:mb-16 max-w-3xl">
        <div class="space-y-6">
            <div class="inline-block" data-reveal>
                <span class="text-xs font-bold tracking-widest uppercase px-4 py-1.5 rounded-full bg-primary-neon/10 text-primary-neon border border-primary-neon/20">
                    <span data-lang="en">{about?.en.badge ?? "Who I Am"}</span>
                    <span data-lang="id" hidden>{about?.id.badge ?? "Siapa Saya"}</span>
                </span>
            </div>
            <h2 class="text-4xl md:text-6xl font-extrabold text-foreground tracking-tight" data-reveal data-reveal-delay="0.1">
                <span data-lang="en">{about?.en.title ?? "About Me"}</span>
                <span data-lang="id" hidden>{about?.id.title ?? "Tentang Saya"}</span>
            </h2>
            <div class="h-1.5 w-24 bg-primary-neon rounded-full shadow-[0_0_15px_rgba(56,189,248,0.5)]" data-reveal data-reveal-delay="0.15"></div>
            <p class="text-lg md:text-xl text-muted-foreground leading-relaxed font-light" data-reveal data-reveal-delay="0.2">
                <span data-lang="en">{about?.en.description ?? "Fullstack Developer passionate about building efficient, scalable systems and managing entire development lifecycles. Experienced in cloud infrastructure, CI/CD automation, and high-performance applications. Currently contributing at Kementerian PU while pursuing informatics studies."}</span>
                <span data-lang="id" hidden>{about?.id.description ?? "Fullstack Developer yang senang membangun sistem efisien, skalabel, dan tahan banting - mulai dari infrastruktur cloud, CI/CD, sampai aplikasi yang benar-benar jalan di produksi. Saat ini magang di Kementerian PU sambil kuliah informatika."}</span>
            </p>
        </div>
    </div>

    <AboutBentoGrid
        client:visible
        about={aboutGridCopy}
        profile={profileGridData}
        techStack={techStack}
        interests={interests}
    />
</section>
