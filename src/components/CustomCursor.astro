---
// CustomCursor — Minimal ring cursor. Tight lerp, scale on hover.
// Skipped on touch devices (pointer: coarse)
---

<div id="cursor-ring" aria-hidden="true"></div>

<style>
  #cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 32px;
    height: 32px;
    border: 1.5px solid rgb(255 255 255 / 0.25);
    background: transparent;
    border-radius: 50%;
    pointer-events: none;
    z-index: 99999;
    transition: width 0.25s cubic-bezier(0.22, 1, 0.36, 1),
                height 0.25s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.25s ease,
                background 0.25s ease;
    will-change: transform;
  }

  #cursor-ring.hover {
    width: 48px;
    height: 48px;
    border-color: rgb(56 189 248 / 0.5);
    background: rgb(56 189 248 / 0.04);
  }
</style>

<script>
  function initCursor() {
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const ring = document.getElementById('cursor-ring') as HTMLElement;
    if (!ring) return;

    let mouseX = 0;
    let mouseY = 0;
    let ringX = 0;
    let ringY = 0;
    let rafId: number;
    let visible = false;

    // Tight lerp — 0.15 feels responsive without lag
    function tick() {
      ringX += (mouseX - ringX) * 0.15;
      ringY += (mouseY - ringY) * 0.15;
      ring.style.transform = `translate(${ringX - 16}px, ${ringY - 16}px)`;
      rafId = requestAnimationFrame(tick);
    }
    rafId = requestAnimationFrame(tick);

    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!visible) {
        visible = true;
        ring.style.opacity = '1';
      }
    }

    function onMouseLeave() {
      ring.style.opacity = '0';
      visible = false;
    }

    function onMouseEnter() {
      if (visible) return;
      visible = true;
      ring.style.opacity = '1';
    }

    // Scale up on interactive elements
    const interactiveSelector = 'a, button, [role="button"], .magnetic, [data-cursor]';

    function onMouseOver(e: MouseEvent) {
      if (e.target instanceof Element && e.target.closest(interactiveSelector)) {
        ring.classList.add('hover');
      }
    }

    function onMouseOut(e: MouseEvent) {
      if (e.target instanceof Element && e.target.closest(interactiveSelector)) {
        ring.classList.remove('hover');
      }
    }

    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('mouseenter', onMouseEnter);
    document.addEventListener('mouseover', onMouseOver);
    document.addEventListener('mouseout', onMouseOut);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(rafId);
    });

    document.addEventListener('astro:after-swap', () => {
      rafId = requestAnimationFrame(tick);
    });
  }

  initCursor();
  document.addEventListener('astro:after-swap', initCursor);
</script>
