---
// CustomCursor — pointer: fine devices only (skipped on touch)
---

<div id="cursor-dot" aria-hidden="true"></div>
<div id="cursor-ring" aria-hidden="true"></div>

<style>
  #cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    background: rgb(56 189 248);
    border-radius: 50%;
    pointer-events: none;
    z-index: 99999;
    mix-blend-mode: difference;
  }

  #cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 36px;
    height: 36px;
    border: 2px solid rgb(56 189 248 / 0.6);
    background: transparent;
    border-radius: 50%;
    pointer-events: none;
    z-index: 99999;
    mix-blend-mode: normal;
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initCursor() {
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const dot = document.getElementById('cursor-dot') as HTMLElement;
    const ring = document.getElementById('cursor-ring') as HTMLElement;

    if (!dot || !ring) return;

    let mouseX = 0;
    let mouseY = 0;
    let ringX = 0;
    let ringY = 0;
    let rafId: number;
    let visible = false;

    // Set initial state — hidden, centered on transform origin
    gsap.set([dot, ring], { xPercent: -50, yPercent: -50, opacity: 0 });

    // RAF loop: ring lerps toward mouse
    function tick() {
      ringX += (mouseX - ringX) * 0.1;
      ringY += (mouseY - ringY) * 0.1;
      gsap.set(ring, { x: ringX, y: ringY });
      rafId = requestAnimationFrame(tick);
    }

    rafId = requestAnimationFrame(tick);

    // Dot follows immediately
    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      gsap.to(dot, { x: e.clientX, y: e.clientY, duration: 0.08, ease: 'none' });

      if (!visible) {
        visible = true;
        gsap.to([dot, ring], { opacity: 1, duration: 0.3 });
      }
    }

    // Hide when mouse leaves the viewport
    function onMouseLeave() {
      gsap.to([dot, ring], { opacity: 0, duration: 0.2 });
      visible = false;
    }

    function onMouseEnter() {
      if (visible) return;
      visible = true;
      gsap.to([dot, ring], { opacity: 1, duration: 0.3 });
    }

    // Hover enlargement via event delegation
    const interactiveSelector = 'a, button, [role="button"], .magnetic';

    function getInteractiveTarget(el: EventTarget | null): Element | null {
      if (!(el instanceof Element)) return null;
      return el.closest(interactiveSelector);
    }

    function onMouseOver(e: MouseEvent) {
      if (getInteractiveTarget(e.target)) {
        gsap.to(ring, { scale: 2.2, duration: 0.25, ease: 'power2.out' });
        gsap.to(dot, { opacity: 0, duration: 0.2 });
      }
    }

    function onMouseOut(e: MouseEvent) {
      if (getInteractiveTarget(e.target)) {
        gsap.to(ring, { scale: 1, duration: 0.25, ease: 'power2.out' });
        gsap.to(dot, { opacity: 1, duration: 0.2 });
      }
    }

    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('mouseenter', onMouseEnter);
    document.addEventListener('mouseover', onMouseOver);
    document.addEventListener('mouseout', onMouseOut);

    // Clean up RAF on view transitions to avoid duplicate loops
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(rafId);
    });

    document.addEventListener('astro:after-swap', () => {
      rafId = requestAnimationFrame(tick);
    });
  }

  // Run on initial load and after every view-transition navigation
  initCursor();
  document.addEventListener('astro:after-swap', initCursor);
</script>
