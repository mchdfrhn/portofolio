---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import Bi from '@/components/site/Bi.astro';
import { getProjects } from '@/lib/projects';

export const prerender = true;

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project, i) => ({
		params: { slug: project.slug },
		props: { project, index: i, next: projects[(i + 1) % projects.length] },
	}));
}

const { project, index, next } = Astro.props;
const { entry } = project;
const sections = [
	{ en: 'Problem', id: 'Masalah', key: 'problem' },
	{ en: 'What I built', id: 'Yang saya bangun', key: 'solution' },
	{ en: 'Outcome', id: 'Hasil', key: 'impact' },
] as const;
---

<Layout title={`${entry.title} — Mochammad Farhan Ali`} description={entry.en.tagline}>
	<Header home={false} />
	<main class="mx-auto max-w-3xl px-4 sm:px-6">
		<article class="pb-16 pt-12 sm:pt-16">
			<a href="/#work" class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground">
				← <Bi en="All work" id="Semua proyek" />
			</a>
			<p class="mt-10 font-mono text-xs uppercase tracking-[0.14em] text-primary">
				<Bi en="Case study" id="Studi kasus" /> {String(index + 1).padStart(2, '0')}
			</p>
			<h1 class="mt-3 font-serif text-4xl leading-[1.05] sm:text-6xl">{entry.title}</h1>
			<p class="mt-4 text-lg text-muted-foreground"><Bi en={entry.en.tagline} id={entry.id.tagline} /></p>

			<dl class="mt-8 grid grid-cols-[6.5rem_1fr] gap-y-2 border-y border-border py-4 text-sm">
				<dt class="pt-0.5 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Stack</dt>
				<dd class="font-mono text-[13px]">{entry.tech.join(' · ')}</dd>
				{entry.demo && (
					<>
						<dt class="pt-0.5 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Live</dt>
						<dd class="min-w-0 break-words"><a href={entry.demo} target="_blank" rel="noopener noreferrer" class="link">{entry.demo.replace('https://', '')} ↗︎</a></dd>
					</>
				)}
				{entry.github && (
					<>
						<dt class="pt-0.5 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground"><Bi en="Code" id="Kode" /></dt>
						<dd class="min-w-0 break-words"><a href={entry.github} target="_blank" rel="noopener noreferrer" class="link">{entry.github.replace('https://', '')} ↗︎</a></dd>
					</>
				)}
			</dl>

			{entry.image && (
				<figure class="mt-10 overflow-hidden rounded-sm border border-border">
					<img src={entry.image} alt={`${entry.title} screenshot`} class="w-full" />
				</figure>
			)}

			<div class="mt-12 space-y-10">
				{sections.map((s, i) => (
					<section class="grid gap-3 sm:grid-cols-[9.5rem_1fr] sm:gap-6">
						<h2 class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground sm:pt-1.5">
							<span class="text-primary">{String(i + 1).padStart(2, '0')}</span> <Bi en={s.en} id={s.id} />
						</h2>
						<p class="text-[1.0625rem] leading-relaxed"><Bi en={entry.en[s.key]} id={entry.id[s.key]} /></p>
					</section>
				))}
			</div>

			{next.slug !== project.slug && (
				<a href={`/projects/${next.slug}`} class="group mt-20 block border-t border-foreground/80 pt-4">
					<span class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground"><Bi en="Next case study" id="Studi kasus berikutnya" /></span>
					<span class="mt-2 block font-serif text-3xl transition-colors group-hover:text-primary">{next.entry.title} →</span>
				</a>
			)}
		</article>
	</main>
	<Footer />
</Layout>
