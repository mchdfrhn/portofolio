---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { projectImage } from '@/lib/images';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import Bi from '@/components/site/Bi.astro';
import { getProjects } from '@/lib/projects';
import { linkOrEmpty } from '@/lib/identity';

export const prerender = true;

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project, i) => ({
		params: { slug: project.slug },
		props: { project, index: i, next: projects[(i + 1) % projects.length] },
	}));
}

const { project, index, next } = Astro.props;
const { entry } = project;
const cover = projectImage(entry.image);
const gallery = (
	await Promise.all(
		entry.gallery.map(async (shot) => {
			const img = projectImage(shot.image);
			if (!img) return [];
			// Lightbox rendition: same widths/sizes as the cover so the popup matches the main image
			const full = await getImage({ src: img, widths: [720, 1080, 1440], format: 'webp' });
			return [{ ...shot, img, full }];
		}),
	)
).flat();
const demo = linkOrEmpty(entry.demo);
const github = linkOrEmpty(entry.github);
const sections = [
	{ en: 'Problem', id: 'Masalah', key: 'problem' },
	{ en: 'What I built', id: 'Yang saya bangun', key: 'solution' },
	{ en: 'Outcome', id: 'Hasil', key: 'impact' },
] as const;
---

<Layout title={`${entry.title.split(" — ")[0]} · Case Study · Farhan Ali`} description={entry.en.tagline}>
	<Header home={false} />
	<main class="mx-auto max-w-3xl px-4 sm:px-6">
		<article class="pb-16 pt-12 sm:pt-16">
			<a href="/projects" class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground">
				← <Bi en="All work" id="Semua proyek" />
			</a>
			<p class="mt-10 font-mono text-xs uppercase tracking-[0.14em] text-primary">
				<Bi en="Case study" id="Studi kasus" /> {String(index + 1).padStart(2, '0')}
			</p>
			<h1 style={`view-transition-name: title-${project.slug}`} class="mt-3 font-serif text-4xl leading-[1.05] sm:text-6xl">{entry.title}</h1>
			<p class="mt-4 text-lg text-muted-foreground"><Bi en={entry.en.tagline} id={entry.id.tagline} /></p>

			<dl class="mt-8 grid grid-cols-[6.5rem_1fr] gap-y-2 border-y border-border py-4 text-sm">
				{entry.year && (
					<>
						<dt class="pt-0.5 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground"><Bi en="Year" id="Tahun" /></dt>
						<dd class="font-mono text-[13px]">{entry.year}</dd>
					</>
				)}
				<dt class="pt-0.5 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Stack</dt>
				<dd class="font-mono text-[13px]">{entry.tech.join(' · ')}</dd>
				{demo && (
					<>
						<dt class="pt-0.5 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Live</dt>
						<dd class="min-w-0 break-words"><a href={demo} target="_blank" rel="noopener noreferrer" class="link">{demo.replace('https://', '')} ↗︎</a></dd>
					</>
				)}
				{github && (
					<>
						<dt class="pt-0.5 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground"><Bi en="Code" id="Kode" /></dt>
						<dd class="min-w-0 break-words"><a href={github} target="_blank" rel="noopener noreferrer" class="link">{github.replace('https://', '')} ↗︎</a></dd>
					</>
				)}
			</dl>

			{cover && (
				<figure class="mt-10 overflow-hidden rounded-sm border border-border" style={`view-transition-name: shot-${project.slug}`}>
					<Image src={cover} alt={`${entry.title} screenshot`} widths={[720, 1080, 1440]} sizes="(min-width: 768px) 720px, calc(100vw - 32px)" loading="eager" class="w-full" />
				</figure>
			)}

			{gallery.length > 0 && (
				<div class="mt-6 grid gap-6 sm:grid-cols-2">
					{gallery.map((shot, i) => (
						<figure data-m-reveal>
							<button
								type="button"
								data-lightbox
								data-src={shot.full.src}
								data-srcset={shot.full.srcSet.attribute}
								data-w={shot.img.width}
								data-h={shot.img.height}
								data-en={shot.captionEn}
								data-id={shot.captionId}
								data-fig={`FIG. ${String(i + 2).padStart(2, '0')}`}
								class="block w-full cursor-zoom-in overflow-hidden rounded-sm border border-border"
								aria-haspopup="dialog"
							>
								<Image src={shot.img} alt={shot.captionEn} widths={[400, 700, 1000]} sizes="(min-width: 768px) 348px, (min-width: 640px) calc(50vw - 36px), calc(100vw - 32px)" class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 hover:scale-[1.02]" />
							</button>
							<figcaption class="mt-2 text-sm text-muted-foreground">
								<span class="mr-1.5 font-mono text-xs text-primary">FIG. {String(i + 2).padStart(2, '0')}</span>
								<Bi en={shot.captionEn} id={shot.captionId} />
							</figcaption>
						</figure>
					))}
				</div>
			)}

			<div class="mt-12 space-y-10">
				{sections.map((s, i) => (
					<section data-m-reveal class="grid gap-3 sm:grid-cols-[9.5rem_1fr] sm:gap-6">
						<h2 class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground sm:pt-1.5">
							<span class="text-primary">{String(i + 1).padStart(2, '0')}</span> <Bi en={s.en} id={s.id} />
						</h2>
						<p class="text-[1.0625rem] leading-relaxed"><Bi en={entry.en[s.key]} id={entry.id[s.key]} /></p>
					</section>
				))}
			</div>

			{next.slug !== project.slug && (
				<a href={`/projects/${next.slug}`} data-m-reveal class="group mt-20 block border-t border-foreground/80 pt-4">
					<span class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground"><Bi en="Next case study" id="Studi kasus berikutnya" /></span>
					<span class="mt-2 block font-serif text-3xl transition-colors group-hover:text-primary">{next.entry.title} →</span>
				</a>
			)}
		</article>
	</main>
	{gallery.length > 0 && (
		<dialog id="lightbox" class="lightbox m-auto w-[min(720px,calc(100vw-32px))] max-w-none bg-transparent p-0 text-foreground" aria-label="Image preview">
			<figure>
				<div class="relative overflow-hidden rounded-sm border border-border bg-background">
					<img data-lightbox-img alt="" sizes="(min-width: 768px) 720px, calc(100vw - 32px)" class="block max-h-[80vh] w-full object-contain" />
				</div>
				<figcaption class="mt-2 flex items-start justify-between gap-4 text-sm text-white/90">
					<span>
						<span data-lightbox-fig class="mr-1.5 font-mono text-xs text-primary"></span>
						<span data-lang="en" data-lightbox-en></span><span data-lang="id" data-lightbox-id></span>
					</span>
					<button type="button" data-lightbox-close class="shrink-0 font-mono text-xs uppercase tracking-[0.14em] hover:text-primary">
						<Bi en="Close ✕" id="Tutup ✕" />
					</button>
				</figcaption>
			</figure>
		</dialog>
	)}
	<Footer />
</Layout>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
	if (dialog) {
		const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
		const set = (sel: string, text = '') => (dialog.querySelector(sel)!.textContent = text);

		document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const d = btn.dataset;
				img.removeAttribute('src');
				img.srcset = d.srcset ?? '';
				img.src = d.src ?? '';
				img.width = Number(d.w);
				img.height = Number(d.h);
				img.alt = d.en ?? '';
				set('[data-lightbox-fig]', d.fig);
				set('[data-lightbox-en]', d.en);
				set('[data-lightbox-id]', d.id);
				dialog.showModal();
			});
		});

		dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
		// A click on the backdrop lands on the dialog element itself
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
	}
</script>
