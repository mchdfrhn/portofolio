---
import Layout from '../../layouts/Layout.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import Sheet from '@/components/site/Sheet.astro';
import Bi from '@/components/site/Bi.astro';
import ProjectCard from '@/components/site/ProjectCard.astro';
import { getProjects } from '@/lib/projects';
import { tagCounts, PROJECT_TAGS } from '@/lib/tags';

export const prerender = true;

const projects = await getProjects();
const counts = tagCounts(projects.map((p) => ({ tags: p.entry.tags })));
const chip =
	'rounded-sm border border-border px-3 py-1.5 text-muted-foreground transition-colors hover:text-foreground aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background';
---

<Layout title="Projects · Farhan Ali">
	<Header home={false} />
	<main class="mx-auto max-w-3xl px-4 sm:px-6">
		<div class="pt-12 sm:pt-16">
			<a href="/" class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground">
				← <Bi en="Home" id="Beranda" />
			</a>
		</div>
		<Sheet id="projects" no="02" en="All projects" idLabel="Semua proyek">
			{counts.length > 0 && (
				<div id="tag-filter" hidden class="mb-8">
					<div class="flex flex-wrap gap-2 font-mono text-xs">
						<button type="button" data-tag="" aria-pressed="true" class={chip}>
							<Bi en="All" id="Semua" /> ({projects.length})
						</button>
						{counts.map(({ tag, count }) => (
							<button type="button" data-tag={tag} aria-pressed="false" class={chip}>
								<Bi en={PROJECT_TAGS[tag].en} id={PROJECT_TAGS[tag].id} /> ({count})
							</button>
						))}
					</div>
				</div>
			)}
			<ul data-project-grid class="grid gap-x-6 gap-y-10 sm:grid-cols-2">
				{projects.map(({ slug, entry }) => <ProjectCard slug={slug} entry={entry} />)}
			</ul>
		</Sheet>
	</main>
	<Footer />
</Layout>

<script>
	import { resolveTag } from '../../lib/tags';

	const bar = document.getElementById('tag-filter');
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('#tag-filter [data-tag]')];
	const cards = [...document.querySelectorAll<HTMLElement>('[data-project-grid] > li')];

	if (bar && buttons.length) {
		bar.hidden = false;
		const available = buttons.map((b) => b.dataset.tag ?? '').filter(Boolean);

		const apply = (tag: string | null) => {
			for (const b of buttons) b.setAttribute('aria-pressed', String((b.dataset.tag || null) === tag));
			for (const c of cards) {
				const tags = (c.dataset.tags ?? '').split(' ');
				c.classList.toggle('hidden', tag !== null && !tags.includes(tag));
			}
		};

		apply(resolveTag(new URLSearchParams(location.search).get('tag'), available));

		for (const b of buttons) {
			b.addEventListener('click', () => {
				const tag = b.dataset.tag || null;
				apply(tag);
				const url = new URL(location.href);
				if (tag) url.searchParams.set('tag', tag);
				else url.searchParams.delete('tag');
				history.replaceState(null, '', url);
			});
		}
	}
</script>
