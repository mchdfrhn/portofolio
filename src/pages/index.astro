---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '@/components/Navbar';
import Hero from '@/components/Hero.astro';
import AboutBento from '@/components/AboutBento.astro';
import AboutDescription from '@/components/AboutDescription.astro';
import { Projects, type ProjectData } from '@/components/Projects';
import { SipekadCaseStudy } from '@/components/SipekadCaseStudy';
import Services from '@/components/Services.astro';
import Experience from '@/components/Experience.astro';
import StackMarquee from '@/components/StackMarquee.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import ExitIntentPopup from '@/components/ExitIntentPopup';
import StickyCTA from '@/components/StickyCTA';
import { reader } from '@/lib/reader';

const rawProjects = await reader.collections.projects.all();
rawProjects.sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99));

const projectsData: ProjectData[] = rawProjects.map(({ slug, entry }) => ({
  slug,
  title: entry.title,
  icon: entry.icon,
  image: entry.image ?? null,
  github: entry.github,
  demo: entry.demo,
  tech: [...entry.tech],
  en: { ...entry.en },
  id: { ...entry.id },
}));
---

<Layout title="Mochamad Farhan Ali | Fullstack Developer | Vibe Coder">
	<Navbar client:visible />
	
	<main class="w-full mx-auto overflow-x-hidden">
        <!-- Hero Section -->
        <div class="px-0 pt-0 md:pt-10">
            <Hero />
        </div>
        
        <!-- About Section (Slightly darker/lighter background for depth) -->
        <div class="w-full bg-secondary/30 dark:bg-slate-900/40 border-y border-border dark:border-white/5 shadow-sm dark:shadow-inner mt-10 md:mt-32">
            <div class="max-w-[1600px] mx-auto px-4 sm:px-10 lg:px-16 py-16 md:py-32 space-y-16 md:space-y-40">
                <AboutBento />
                <AboutDescription />
            </div>
        </div>

        <!-- Projects & Experience -->
        <div class="max-w-[1600px] mx-auto px-4 sm:px-10 lg:px-16 py-16 md:py-32 space-y-16 md:space-y-40">
            <Services />
            <Projects client:visible projects={projectsData} />
            <SipekadCaseStudy client:visible />
            <Experience />
        </div>
	</main>
    
    <div class="w-full">
        <StackMarquee />
    </div>

    <!-- Contact & Footer -->
    <div class="bg-secondary/40 dark:bg-slate-900/60 shadow-[inset_0_10px_30px_rgba(0,0,0,0.03)] dark:shadow-[inset_0_20px_50px_rgba(0,0,0,0.5)]">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-10 lg:px-16 pb-10 pt-14 md:pb-12 md:pt-24">
            <Contact />
        </div>
    	<Footer />
    </div>
	<ExitIntentPopup client:only="react" />
	<StickyCTA client:only="react" />
</Layout>
